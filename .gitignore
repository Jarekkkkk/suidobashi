node_modules/
.env
.sui-tokyo/
*.log
move/build/

# macOS
.DS_Store

# adoptGuardFrom writes addresses.js.tmp before renaming it into place, so a
# failure between the two can leave one behind. Never commit a half-written copy
# of the file that holds every deployed id.
*.tmp

# `sui client test-upgrade` writes an ephemeral publication record per environment.
# The file says so itself: "this file should not be committed to source control".
# move/Published.toml is the real record of what is deployed.
Pub.*.toml


# Local conversations and installed talents. Never committed: it is this machine's state.
data/
