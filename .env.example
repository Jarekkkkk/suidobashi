# sui-tokyo configuration. Copy to `.env` if you need to override any of these.
# `.env` is git-ignored; this file is not.
#
# NOTHING HERE IS REQUIRED for normal operation. Every value below has a default,
# and the defaults are shown. Signing is done by the Slush browser extension, so
# the application needs no key material at all.

# ─────────────────────────────────────────────────────────────────────────────
# Local model (the intent layer)
# ─────────────────────────────────────────────────────────────────────────────
# Served by `bun run qvac`. Any OpenAI-compatible endpoint works.
# QVAC_URL="http://127.0.0.1:11434/v1/chat/completions"
# QVAC_MODEL="intent"

# ─────────────────────────────────────────────────────────────────────────────
# Local server
# ─────────────────────────────────────────────────────────────────────────────
# Binds loopback only. A non-loopback bind is REFUSED unless you opt in, because
# this process can build transactions your wallet will be asked to approve.
# UI_PORT="8788"
# UI_HOST="127.0.0.1"
# UI_ALLOW_NON_LOOPBACK="1"

# ─────────────────────────────────────────────────────────────────────────────
# Roles
# ─────────────────────────────────────────────────────────────────────────────
# Defaults to the deployer recorded in src/addresses.js. Set these only to run
# the agent paths as a DIFFERENT address than the owner — which is what makes the
# caller gate (`ENotAgent`) actually testable. See docs/ROADMAP.md Phase 1.
# SUI_SENDER="0x…"
# SUI_AGENT_ADDRESS="0x…"      # defaults to SUI_SENDER
# SUI_DESTINATION="0x…"        # defaults to SUI_SENDER

# ─────────────────────────────────────────────────────────────────────────────
# Provisioning only — the one place a raw key is used
# ─────────────────────────────────────────────────────────────────────────────
# ONLY src/setup-vault.js reads this, to create the vault and mint its OwnerCap
# the first time. Nothing in the app, the server, or any agent path uses it.
# If you are not provisioning a fresh deployment, do not set it.
# SUI_SECRET_KEY="suiprivkey1…"

# ─────────────────────────────────────────────────────────────────────────────
# Which objects to act on
# ─────────────────────────────────────────────────────────────────────────────
# All default to src/addresses.js. The server passes GUARD_ID and
# GUARD_SHARED_VERSION itself, because a new position mints a NEW guard —
# see docs/ARCHITECTURE.md on the position cycle.
# GUARD_ID="0x…"
# GUARD_SHARED_VERSION="0"

# ─────────────────────────────────────────────────────────────────────────────
# Per-action overrides. The server sets these; they exist so a single script can
# be run by hand from the command line.
# ─────────────────────────────────────────────────────────────────────────────
# Swap
# SWAP_MIST="20000000"                    # 0.02 SUI
# SWAP_POLICY_ID="0x…"
# SWAP_POLICY_SHARED="0"
# SWAP_POOL_ID="0x…"
# SWAP_POOL_SHARED="0"

# Hire / venue administration
# HIRE="standard"                         # standard | cautious
# VENUE="0x…"
# ALLOW="true"
# SUSPEND="true"
# AGENT="0x…"
# CAP_ID="0x…"

# Budget and funding
# BUDGET_MIST="50000000"                  # 0.05 SUI
# TOPUP_MIST="100000000"                  # 0.1 SUI
# SKIP_BUDGET="1"                         # fund the vault without touching the ceiling

# Position lifecycle
# FIX_AMOUNT="500000"                     # 0.5 USDC, 6 decimals
# FIX_AMOUNT_A="true"
# SUPPLY_SUI="600000000"                  # 0.6 SUI of headroom; the surplus returns
# NEW_TICK_LOWER="68800"
# NEW_TICK_UPPER="69200"
